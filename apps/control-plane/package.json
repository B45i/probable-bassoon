{
  "name": "@ab-tester/control-plane",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to ../../.wrangler-state",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "openapi": "tsx scripts/generate-openapi.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to ../../.wrangler-state"
  },
  "dependencies": {
    "@ab-tester/db": "workspace:*",
    "@ab-tester/shared": "workspace:*",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ab-tester/tsconfig": "workspace:*",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260815.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
