{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ab-tester-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Written through to KV after every D1 write (D2); same namespace id as
  // apps/assignment's EXPERIMENT_CONFIG binding. Fill in once created
  // (`wrangler kv namespace create EXPERIMENT_CONFIG`).
  "kv_namespaces": [{ "binding": "EXPERIMENT_CONFIG", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  // Experiment/variant config and conversions (D6, Appendix B.1). Fill in once created
  // (`wrangler d1 create ab-tester`); migrations live in packages/db/migrations and are
  // applied with `wrangler d1 migrations apply`, not drizzle-kit.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ab-tester",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // One instance per experiment (D3, Appendix B.2). `new_sqlite_classes` (not
  // `new_classes`) because it uses the SQLite-backed Durable Object storage the schema
  // in Appendix B.2 assumes.
  "durable_objects": {
    "bindings": [{ "name": "EXPOSURES", "class_name": "ExperimentExposures" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ExperimentExposures"] }]
}
