{
  "extends": "@ab-tester/tsconfig/workers.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"]
  },
  // src/env.d.ts is explicit: this script imports ../src/app (for Env), but nothing
  // in the scripts/ import graph actually `import`s env.d.ts — it's a pure ambient
  // `declare global`, so tsc only sees it if `include` names it directly.
  "include": ["scripts", "src/env.d.ts"]
}
