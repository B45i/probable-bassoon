{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "openapi": {
      "outputs": ["openapi.json"]
    },
    "generate": {
      "dependsOn": ["@ab-tester/control-plane#openapi"],
      "outputs": ["src/generated/**"]
    }
  }
}
